[
  {
    "origin": ["*"],
    "method": ["GET", "POST", "PUT", "DELETE", "HEAD"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "X-Bz-File-Name",
      "X-Bz-Content-Sha1",
      "X-Bz-Info-src_last_modified_millis",
      "x-goog-upload-protocol",
      "x-goog-upload-command",
      "x-goog-upload-content-type",
      "x-firebase-storage-version",
      "*"
    ],
    "maxAgeSeconds": 3600
  }
]

